{
  "name": "Complex Demo Scene",
  "type": "scene",
  "version": "1.0",
  "camera": {
    "bounds": { "x": 0, "y": 0, "width": 20, "height": 15 },
    "zoom": 1.0
  },
  "layers": [
    {
      "name": "Background",
      "type": "object_layer",
      "entities": [
        {
          "name": "Sky",
          "transform": { "pos": { "x": 10, "y": 6 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 1, 
                "param": { "width": 24, "height": 14, "color": { "r": 20, "g": 20, "b": 40, "a": 1 }, "fill": true }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Game",
      "type": "main",
      "entities": [
        {
          "name": "Ground",
          "transform": { "pos": { "x": 10, "y": 12 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 1,
                "param": { "width": 20, "height": 1, "color": { "r": 50, "g": 150, "b": 50, "a": 1 } }
              }
            }
          ]
        },
        {
          "name": "Player",
          "transform": { "pos": { "x": 10, "y": 6 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            { 
              "type": "Sprite", 
              "props": { "path": "assets/player.png", "width": 2, "height": 2 } 
            },
            {
              "type": "Rotator",
              "props": { "speed": 2.0 }
            }
          ]
        },
        {
          "name": "Floating Text",
          "transform": { "pos": { "x": 10, "y": 3 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Text",
              "props": {
                "text": "Hello Neptune!",
                "align": "center",
                "color": { "r": 255, "g": 255, "b": 255, "a": 1 },
                "font": { "size": 0.8, "family": "Arial", "weight": "bold" }
              }
            }
          ]
        }
      ]
    }
  ]
}
