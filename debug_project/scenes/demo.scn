{
  "name": "Metroidvania Demo",
  "type": "scene",
  "version": "1.0",
  "camera": {
    "bounds": { "x": 0, "y": 0, "width": 20, "height": 15 },
    "zoom": 1.0
  },
  "layers": [
    {
      "name": "Background",
      "type": "parallax",
      "entities": [
        {
          "name": "Sky",
          "transform": { "pos": { "x": 0, "y": 0 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 1, 
                "param": { "width": 100, "height": 100, "color": { "r": 20, "g": 20, "b": 40, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.0, "factorY": 0.0 }
            }
          ]
        },
        {
          "name": "Mountains",
          "transform": { "pos": { "x": 10, "y": 10 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 3, 
                "param": { "width": 20, "height": 10, "color": { "r": 40, "g": 40, "b": 60, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.5, "factorY": 0.1 }
            }
          ]
        }
      ]
    },
    {
      "name": "Level",
      "type": "tilemap",
      "src": "./scenes/level1.map"
    },
    {
      "name": "Gameplay",
      "type": "main",
      "entities": [
        {
          "name": "Player",
          "transform": { "pos": { "x": 5, "y": 5 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            { 
              "type": "Sprite", 
              "props": { "path": "assets/player.png", "width": 1.2, "height": 1.2 } 
            },
            {
              "type": "BoxCollider",
              "props": { "width": 0.8, "height": 0.8 }
            },
            {
              "type": "PlayerController",
              "props": { "speed": 10.0, "jumpForce": 25.0 }
            }
          ]
        },
        {
            "name": "Label",
            "transform": { "pos": { "x": 5, "y": 3 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
            "components": [
                {
                    "type": "Text",
                    "props": { "text": "Use Arrow Keys!", "font": { "size": 0.5, "color": "white" } }
                }
            ]
        }
      ]
    }
  ]
}
