{
  "name": "Dungeon",
  "type": "scene",
  "version": "1.0",
  "camera": {
    "bounds": { "x": 0, "y": 0, "width": 20, "height": 15 },
    "zoom": 1.0
  },
  "layers": [
    {
      "name": "Background",
      "type": "parallax",
      "entities": [
        {
          "name": "Sky",
          "transform": { "pos": { "x": 0, "y": 0 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 1, 
                "param": { "width": 100, "height": 100, "color": { "r": 20, "g": 20, "b": 40, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.0, "factorY": 0.0 }
            }
          ]
        },
        {
          "name": "Mountains",
          "transform": { "pos": { "x": 10, "y": 10 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 3, 
                "param": { "width": 20, "height": 10, "color": { "r": 40, "g": 40, "b": 60, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.5, "factorY": 0.1 }
            }
          ]
        }
      ]
    },
    {
      "name": "Level",
      "type": "tilemap",
      "src": "./scenes/level2.map"
    },
    {
      "name": "Gameplay",
      "type": "main",
      "entities": [
        {
          "name": "Encounter Director",
          "transform": { "pos": { "x": 0, "y": 0 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [{ "type": "DungeonEncounter", "props": {} }]
        },
        {
          "name": "Slime Ember",
          "transform": { "pos": { "x": 7, "y": 5 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [{ "type": "Shape", "props": { "geometry": 1, "param": { "width": 0.8, "height": 0.8, "color": { "r": 220, "g": 70, "b": 65, "a": 1 }, "fill": true } } }]
        },
        {
          "name": "Slime Moss",
          "transform": { "pos": { "x": 4, "y": 8 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [{ "type": "Shape", "props": { "geometry": 1, "param": { "width": 0.8, "height": 0.8, "color": { "r": 85, "g": 190, "b": 95, "a": 1 }, "fill": true } } }]
        },
        {
          "name": "Slime Azure",
          "transform": { "pos": { "x": 10, "y": 8 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [{ "type": "Shape", "props": { "geometry": 1, "param": { "width": 0.8, "height": 0.8, "color": { "r": 70, "g": 135, "b": 220, "a": 1 }, "fill": true } } }]
        },
        {
          "name": "Dungeon Warden",
          "transform": { "pos": { "x": 14, "y": 8 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [{ "type": "Shape", "props": { "geometry": 1, "param": { "width": 1.5, "height": 1.5, "color": { "r": 175, "g": 45, "b": 190, "a": 1 }, "fill": true } } }]
        },
        {
          "name": "Town Stairs",
          "transform": { "pos": { "x": 3, "y": 5 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": { "geometry": 1, "param": { "width": 1, "height": 2, "color": { "r": 120, "g": 80, "b": 255, "a": 1 }, "fill": true } }
            },
            {
              "type": "ScenePortal",
              "props": { "targetScene": "./scenes/demo.scn", "targetSceneName": "Town", "destinationX": 15, "destinationY": 5 }
            }
          ]
        },
        {
            "name": "Label",
            "transform": { "pos": { "x": 5, "y": 3 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
            "components": [
                {
                    "type": "Text",
                    "props": { "text": "Three slimes patrol this dungeon. Press E on the stairs to return.", "font": { "size": 0.5, "color": "white" } }
                }
            ]
        }
      ]
    }
  ]
}
