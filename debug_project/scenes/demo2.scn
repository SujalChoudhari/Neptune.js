{
  "name": "Dungeon",
  "type": "scene",
  "version": "1.0",
  "camera": {
    "bounds": { "x": 0, "y": 0, "width": 20, "height": 15 },
    "zoom": 1.0
  },
  "layers": [
    {
      "name": "Background",
      "type": "parallax",
      "entities": [
        {
          "name": "Sky",
          "transform": { "pos": { "x": 0, "y": 0 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 1, 
                "param": { "width": 100, "height": 100, "color": { "r": 20, "g": 20, "b": 40, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.0, "factorY": 0.0 }
            }
          ]
        },
        {
          "name": "Mountains",
          "transform": { "pos": { "x": 10, "y": 10 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": {
                "geometry": 3, 
                "param": { "width": 20, "height": 10, "color": { "r": 40, "g": 40, "b": 60, "a": 1 }, "fill": true }
              }
            },
            {
               "type": "Parallax",
               "props": { "factorX": 0.5, "factorY": 0.1 }
            }
          ]
        }
      ]
    },
    {
      "name": "Level",
      "type": "tilemap",
      "src": "./scenes/level2.map"
    },
    {
      "name": "Gameplay",
      "type": "main",
      "entities": [
        {
          "name": "Town Stairs",
          "transform": { "pos": { "x": 3, "y": 5 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
          "components": [
            {
              "type": "Shape",
              "props": { "geometry": 1, "param": { "width": 1, "height": 2, "color": { "r": 120, "g": 80, "b": 255, "a": 1 }, "fill": true } }
            },
            {
              "type": "ScenePortal",
              "props": { "targetScene": "./scenes/demo.scn", "targetSceneName": "Metroidvania Demo", "destinationX": 15, "destinationY": 5 }
            }
          ]
        },
        {
            "name": "Label",
            "transform": { "pos": { "x": 5, "y": 3 }, "rot": 0, "scale": { "x": 1, "y": 1 } },
            "components": [
                {
                    "type": "Text",
                    "props": { "text": "Press E on the stairs to return to town", "font": { "size": 0.5, "color": "white" } }
                }
            ]
        }
      ]
    }
  ]
}
