{
    "name": "Platform Adventure Demo",
    "version": "1.0.0",
    "engine": "neptune.js",
    "description": "A platformer demo showcasing Triton Editor features",
    "resolution": {
        "width": 1280,
        "height": 720
    },
    "startScene": "main",
    "scenes": [
        "scenes/main.scene",
        "scenes/level1.scene"
    ],
    "preferences": {
        "backgroundColor": "#1a1a2e",
        "pixelArt": true,
        "targetFPS": 60
    }
}
