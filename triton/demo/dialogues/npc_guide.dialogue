{
  "id": "npc_guide",
  "nodes": [
    {
      "id": "start",
      "type": "line",
      "speaker": "Guide",
      "portrait": "assets/portraits/guide.png",
      "text": "Welcome to the Triton Demo, adventurer!",
      "next": "intro_choice"
    },
    {
      "id": "intro_choice",
      "type": "choice",
      "options": [
        { "text": "Tell me about this place", "next": "about_hub" },
        { "text": "Where can I go?", "next": "directions" },
        { "text": "How do I fight?", "next": "combat_tips" },
        { "text": "Goodbye", "next": "end" }
      ]
    },
    {
      "id": "about_hub",
      "type": "line",
      "speaker": "Guide",
      "text": "This is the Demo Hub! It showcases all the features of the Triton Editor and Neptune.js engine.",
      "next": "about_hub_2"
    },
    {
      "id": "about_hub_2",
      "type": "line",
      "speaker": "Guide",
      "text": "Here you can explore different areas: platforming challenges, combat arenas, and even a boss fight!",
      "next": "intro_choice"
    },
    {
      "id": "directions",
      "type": "line",
      "speaker": "Guide",
      "text": "To the right is the Platforming Area - great for testing tilemap layers and parallax effects.",
      "next": "directions_2"
    },
    {
      "id": "directions_2",
      "type": "line",
      "speaker": "Guide",
      "text": "Use the doors to teleport to the Combat Arena or the Boss Chamber. Good luck!",
      "next": "intro_choice"
    },
    {
      "id": "combat_tips",
      "type": "line",
      "speaker": "Guide",
      "text": "Combat uses the Larissa RPG system. Your Stats component determines damage and defense.",
      "next": "combat_tips_2"
    },
    {
      "id": "combat_tips_2",
      "type": "line",
      "speaker": "Guide",
      "text": "Bosses have multiple phases! Watch their health - they get more dangerous as it drops.",
      "next": "intro_choice"
    },
    {
      "id": "end",
      "type": "line",
      "speaker": "Guide",
      "text": "Safe travels, adventurer! Return anytime if you need guidance.",
      "next": null
    }
  ]
}
